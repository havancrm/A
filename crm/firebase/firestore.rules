rules_version = '2';

// Access list lives in one document you edit in the Firebase console:
//   config/access  { emails: [ "seller1@gmail.com", ... ], admins: [ "havan.crm@gmail.com" ] }
// Only verified Google accounts whose email is in `emails` can read or write data.
// The nightly backup uses a service account, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function allowed() {
      return signedIn() && request.auth.token.email in access().emails;
    }

    // Only admins may change the access list (and they must do it in the console).
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /customers/{id} {
      allow read, write: if allowed();
    }
    match /visits/{id} {
      allow read, write: if allowed();
    }
    match /tasks/{id} {
      allow read, write: if allowed();
    }
    match /orders/{id} {
      allow read, write: if allowed();
    }

    // Anything not listed above is denied.
  }
}
